{
  "name": "pencil-design-harness",
  "version": "2.10.0",
  "description": "Pencil Design 품질 하네스 — Case A(WPF→템플릿), Case B(템플릿참고→프로젝트 디자인), Case C(웹→JSON→펜슬 컴포넌트), Case D(DesignMD→펜슬 복제), Case S(컨셉아트→스프라이트 시트), Case W(Pencil→HTML), Case M(Blender 모델링→Three.js 웹) 평가 · v2.9.x gpt-image-2/영상 동작 분석/pencil-ops · v2.10.0 blend3d-web-flow 도입: 모델링 우선 파이프라인(레퍼런스 분석→Blender MCP→.blend 자산(design/blend/)→Three.js 재구축→시네마틱 카메라→Playwright 검증→배포)",
  "scope": "pencil-design",
  "layers": {
    "knowledge": "harness/knowledge/",
    "agents": "harness/agents/",
    "engine": "harness/engine/"
  },
  "agents": [
    {
      "name": "design-evaluator",
      "path": "harness/agents/design-evaluator.md",
      "scope": "all-cases"
    },
    {
      "name": "sprite-animator",
      "path": "harness/agents/sprite-animator.md",
      "scope": "case-S",
      "since": "v2.8.0"
    }
  ],
  "engine_workflows": [
    {
      "name": "design-journey",
      "path": "harness/engine/design-journey.md",
      "scope": "all-cases"
    },
    {
      "name": "sprite-animation-flow",
      "path": "harness/engine/sprite-animation-flow.md",
      "scope": "case-S",
      "since": "v2.8.0"
    },
    {
      "name": "level-achievement",
      "path": "harness/engine/level-achievement-system.md",
      "scope": "rpg"
    },
    {
      "name": "blend3d-web-flow",
      "path": "harness/engine/blend3d-web-flow.md",
      "scope": "case-M",
      "since": "v2.10.0"
    }
  ],
  "knowledge_docs": [
    {
      "name": "design-craft",
      "path": "harness/knowledge/design-craft.md"
    },
    {
      "name": "midi-orchestra",
      "path": "harness/knowledge/midi-orchestra.md"
    },
    {
      "name": "sprite-animation-craft",
      "path": "harness/knowledge/sprite-animation-craft.md",
      "since": "v2.8.0"
    },
    {
      "name": "pencil-ops",
      "path": "harness/knowledge/pencil-ops.md",
      "since": "v2.9.2",
      "scope": "environment",
      "note": "펜슬 앱 운영/트러블슈팅 — 멀티모니터 창 위치 복구 (windowBounds in config.json)"
    },
    {
      "name": "blend3d-web-craft",
      "path": "harness/knowledge/blend3d-web-craft.md",
      "since": "v2.10.0",
      "scope": "case-M",
      "note": "Case M 3축 평가 기준 — 모델링 충실도(40)/웹 재구축 정합성(30)/카메라 연출(30)"
    }
  ],
  "evaluation": {
    "design": {
      "cases": {
        "A": {
          "axes": 3,
          "maxScore": 100,
          "label": "WPF → Template Enrichment",
          "target": "design/wpf-animation.pen"
        },
        "B": {
          "axes": 3,
          "maxScore": 100,
          "label": "Template Ref → Project Design",
          "target": "projects/design/*.pen"
        },
        "C": {
          "axes": 3,
          "maxScore": 100,
          "label": "Web Animation → JSON → Pencil Component (Copycat)",
          "target": "design/json/sample/*.json"
        },
        "D": {
          "axes": 3,
          "maxScore": 100,
          "label": "DesignMD → Pencil Replication (Tokens/Components/Templates)",
          "target": "design/design-md.pen"
        },
        "S": {
          "axes": 3,
          "maxScore": 100,
          "label": "Concept Art → Sprite Sheet (Transparent PNG + Aseprite Hash JSON)",
          "target": "design/sprite/output/_master/index.json"
        },
        "W": {
          "axes": 3,
          "maxScore": 100,
          "label": "Pencil → HTML (SVG Realism + WAAPI)"
        },
        "M": {
          "axes": 3,
          "maxScore": 100,
          "label": "Blender Modeling-First → Three.js Web (Cinematic Camera)",
          "target": "design/blend/*.blend",
          "reference": "harness/knowledge/blend3d-web-craft.md"
        }
      },
      "pipeline_bonus": {
        "A_B": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        },
        "A_W": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        },
        "B_W": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "C_W": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "C_B": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        },
        "D_B": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "D_W": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "S_W": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "S_B": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        },
        "A_S": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        },
        "A_B_W": {
          "multiplier": 1.5,
          "condition": "all >= 60"
        },
        "C_B_W": {
          "multiplier": 1.5,
          "condition": "all >= 60"
        },
        "D_B_W": {
          "multiplier": 1.5,
          "condition": "all >= 60"
        },
        "S_B_W": {
          "multiplier": 1.5,
          "condition": "all >= 60"
        },
        "M_W": {
          "multiplier": 1.3,
          "condition": "both >= 60"
        },
        "S_M": {
          "multiplier": 1.2,
          "condition": "both >= 60"
        }
      },
      "reference": "harness/knowledge/design-craft.md"
    },
    "grades": {
      "A": [
        80,
        100
      ],
      "B": [
        60,
        79
      ],
      "C": [
        40,
        59
      ],
      "D": [
        0,
        39
      ]
    }
  },
  "rpg_system": {
    "enabled": true,
    "max_level": 100,
    "level_state": "harness/logs/level-up/status.json",
    "level_history": "harness/logs/level-up/history.md",
    "achievement_state": "harness/logs/achievements/achievements.json",
    "achievement_history": "harness/logs/achievements/history.md",
    "rules": "harness/engine/level-achievement-system.md",
    "xp_formula": {
      "base": "score * 10",
      "grade_multiplier": {
        "A": 5,
        "B": 3,
        "C": 1,
        "D": 0.5
      },
      "type_multiplier": {
        "A": 1.2,
        "B": 1.2,
        "C": 1.2,
        "D": 1.2,
        "S": 1.2,
        "W": 1.2,
        "M": 1.2
      }
    }
  },
